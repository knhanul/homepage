# /etc/nginx/sites-available/nuni-home  (sites-enabled 에 심볼릭 링크)
# nuni 브랜드 홈페이지 — 정적 파일 /var/www/nuni
# HTTPS는 DNS 연결 후 certbot --nginx 가 이 파일에 자동으로 추가합니다.

# nuni.co.kr → www.nuni.co.kr
server {
    listen 80;
    server_name nuni.co.kr;
    return 301 $scheme://www.nuni.co.kr$request_uri;
}

server {
    listen 80;
    server_name www.nuni.co.kr;

    root /var/www/nuni;
    index index.html;
    charset utf-8;
    absolute_redirect off;   # /products → /products/ 이동 시 상대 주소 사용(HTTPS 전환 후에도 안전)

    gzip on;
    gzip_vary on;
    gzip_min_length 512;
    gzip_types text/css application/javascript text/javascript image/svg+xml application/xml text/plain application/json;

    error_page 404 /404.html;
    location = /404.html { internal; }

    # HTML: 항상 최신 확인
    location / {
        try_files $uri $uri/ =404;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    # 정적 자원: CSS/JS는 ?v=해시 로 바뀌므로 길게 캐시
    location /assets/ {
        add_header Cache-Control "public, max-age=2592000" always;
        add_header X-Content-Type-Options "nosniff" always;
        access_log off;
    }

    location = /favicon.ico { add_header Cache-Control "public, max-age=2592000" always; access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }
}
